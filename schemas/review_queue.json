{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "page": {
        "type": "integer",
        "minimum": 1
      },
      "reason": {
        "type": "string",
        "minLength": 1
      },
      "artifacts": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "suggested_action": {
        "type": "string"
      }
    },
    "required": [
      "page",
      "reason",
      "artifacts",
      "suggested_action"
    ]
  }
}
