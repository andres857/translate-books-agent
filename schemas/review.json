{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "action",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "explanation": {
      "type": "string"
    }
  },
  "required": [
    "actions",
    "explanation"
  ],
  "additionalProperties": false
}
