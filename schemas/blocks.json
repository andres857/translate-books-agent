{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "page": {
      "type": "integer",
      "minimum": 1
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "bbox": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4
          },
          "source": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "vector": {
            "type": "boolean"
          },
          "rotate": {
            "enum": [
              0,
              90,
              180,
              270
            ]
          }
        },
        "required": [
          "bbox",
          "source",
          "target"
        ]
      }
    }
  },
  "required": [
    "page",
    "blocks"
  ]
}
